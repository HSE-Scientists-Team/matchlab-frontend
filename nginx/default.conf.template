map $uri $cache_control {
    default "no-store";
    ~^/admin/assets/ "public, max-age=31536000, immutable";
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /healthz { access_log off; return 200 "ok"; }
    location = / { return 302 /admin/; }
    location = /admin { return 301 /admin/; }
    location /admin/assets/ { try_files $uri =404; }
    location /admin/ { try_files $uri /admin/index.html; }
    location /api/ {
        proxy_pass ${GATEWAY_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
    }
    location /docs/ {
        proxy_pass ${DOCS_UPSTREAM};
        proxy_set_header Host $host;
    }
    location / { return 404; }
}
